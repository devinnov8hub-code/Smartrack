# Backend base URL, no trailing slash, e.g. https://smartrack-backend.onrender.com
VITE_API_URL=
# Public Mapbox token (pk.), used by the browser for the map and address search
VITE_MAPBOX_TOKEN=
# Web Push certificate key: Firebase console > Project settings > Cloud Messaging > Web configuration > Generate key pair
VITE_FIREBASE_VAPID_KEY=
