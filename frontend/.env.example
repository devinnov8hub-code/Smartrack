# Backend base URL, no trailing slash, e.g. https://smartrack-backend.onrender.com
VITE_API_URL=
# Google Maps browser key (Maps JavaScript API + Places API (New) enabled),
# restricted to your site's domains. Used for the map and address search
VITE_GOOGLE_MAPS_API_KEY=
# Optional map ID from Google Cloud > Map Management (vector map). Defaults to DEMO_MAP_ID
VITE_GOOGLE_MAP_ID=
# Web Push certificate key: Firebase console > Project settings > Cloud Messaging > Web configuration > Generate key pair
VITE_FIREBASE_VAPID_KEY=
